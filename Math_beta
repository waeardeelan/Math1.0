<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>แบบทดสอบคณิตศาสตร์ ม.ต้น (10 ข้อยาก)</title>
  <link href="https://fonts.googleapis.com/css2?family=Kanit&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Kanit', sans-serif;
      background: linear-gradient(-45deg, #fdfbfb, #ebedee, #f0fff3, #ffedf5);
      background-size: 400% 400%;
      animation: gradient 20s ease infinite;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    @keyframes gradient {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .container {
      max-width: 750px;
      margin: 40px auto;
      background: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
      text-align: center;
      position: relative;
    }

    h1 {
      color: #333;
    }

    input[type="text"] {
      font-size: 18px;
      padding: 8px;
      border-radius: 10px;
      margin-bottom: 15px;
      border: 1px solid #ccc;
      width: 60%;
    }

    #เวลา, #คะแนน, #ผลลัพธ์, #อธิบาย, #สรุป {
      margin-top: 20px;
      font-weight: bold;
      color: #2c3e50;
    }

    #โจทย์ {
      font-size: 22px;
      margin: 25px 0;
    }

    .ตัวเลือก {
      display: block;
      margin: 10px auto;
      padding: 12px 20px;
      font-size: 18px;
      border: none;
      border-radius: 12px;
      background-color: #3498db;
      color: white;
      cursor: pointer;
      width: 70%;
    }

    .ตัวเลือก:hover {
      background-color: #2980b9;
    }

    .ตัวเลือก:disabled {
      background-color: #95a5a6;
      cursor: not-allowed;
    }

    .button-container {
      margin-top: 20px;
    }

    button {
      font-family: 'Kanit', sans-serif;
      padding: 12px 30px;
      font-size: 18px;
      border: none;
      background-color: #2ecc71;
      color: white;
      border-radius: 10px;
      cursor: pointer;
      margin: 10px;
    }

    button:hover {
      background-color: #27ae60;
    }

    #เริ่มใหม่ {
      background-color: #e74c3c;
    }

    #เริ่มใหม่:hover {
      background-color: #c0392b;
    }

    #ตกลง {
      background-color: #3498db;
      display: block;
      margin: 0 auto;
      padding: 12px 30px;
      font-size: 18px;
      border: none;
      color: white;
      border-radius: 10px;
      cursor: pointer;
      margin-top: 20px;
    }

    #ตกลง:hover {
      background-color: #2980b9;
    }

    #ตกลง:disabled {
      background-color: #95a5a6;
      cursor: not-allowed;
    }
  </style>
</head>
<body>
<div class="container">
  <h1>แบบทดสอบคณิตศาสตร์ ม.ต้น (10 ข้อยาก)</h1>
  <input type="text" id="ชื่อผู้ใช้" placeholder="กรอกชื่อของคุณ" onkeyup="ตรวจสอบชื่อ()" />
  <div id="เวลา">เวลา: 20:00</div>
  <div id="โจทย์">กรุณากรอกชื่อก่อนเริ่มแบบทดสอบ</div>
  <div id="ตัวเลือกทั้งหมด"></div>
  <div id="ผลลัพธ์"></div>
  <div id="อธิบาย"></div>
  <div id="คะแนน">คะแนน: 0 จาก 0 ข้อ</div>
  <div id="สรุป"></div>
  <div class="button-container" id="ปุ่มเริ่มใหม่"></div>
  <button id="ตกลง" style="display:none" onclick="เริ่มโจทย์()" disabled>ตกลง</button>
  <button id="ถัดไป" style="display:none" onclick="ไปข้อถัดไป()">ถัดไป</button>
</div>

<script>
  const โจทย์ = [
    { ถาม: "ถ้า 3x - 5 = 16, x เท่ากับเท่าไร?", ตัวเลือก: ["7", "6", "5", "4"], คำตอบที่ถูก: "7", อธิบาย: "3x - 5 = 16 ⇒ 3x = 21 ⇒ x = 7" },
    { ถาม: "√144 มีค่าเท่ากับข้อใด?", ตัวเลือก: ["12", "14", "10", "13"], คำตอบที่ถูก: "12", อธิบาย: "√144 = 12 เพราะ 12×12 = 144" },
    { ถาม: "พื้นที่สามเหลี่ยมฐาน 10 ซม. สูง 6 ซม. เท่ากับเท่าไร?", ตัวเลือก: ["30", "60", "16", "36"], คำตอบที่ถูก: "30", อธิบาย: "พื้นที่ = ½ × ฐาน × สูง = ½ × 10 × 6 = 30" },
    { ถาม: "5² × 5³ เท่ากับข้อใด?", ตัวเลือก: ["5⁵", "5⁶", "10⁵", "25³"], คำตอบที่ถูก: "5⁵", อธิบาย: "เลขชี้กำลังฐานเดียวกันบวกกัน ⇒ 2+3 = 5" },
    { ถาม: "ถ้า y แปรผันตรงกับ x และ y = 10 เมื่อ x = 2, y เท่ากับเท่าไรเมื่อ x = 5?", ตัวเลือก: ["25", "20", "15", "30"], คำตอบที่ถูก: "25", อธิบาย: "y = kx → k = 5 ⇒ y = 5×5 = 25" },
    { ถาม: "ร้อยละของ 60 จาก 200 คือเท่าไร?", ตัวเลือก: ["30%", "40%", "50%", "20%"], คำตอบที่ถูก: "30%", อธิบาย: "60 ÷ 200 × 100 = 30%" },
    { ถาม: "พีระมิดฐานสี่เหลี่ยมด้านละ 6 ซม. สูง 9 ซม. ปริมาตร?", ตัวเลือก: ["108", "96", "72", "36"], คำตอบที่ถูก: "108", อธิบาย: "V = (1/3)×6×6×9 = 108" },
    { ถาม: "ถ้า 2(x+3) = 18, x คือ?", ตัวเลือก: ["6", "7", "8", "5"], คำตอบที่ถูก: "6", อธิบาย: "2(x+3)=18 ⇒ x+3=9 ⇒ x=6" },
    { ถาม: "จำนวนเฉลี่ยของ 10, 20, 30 คือ?", ตัวเลือก: ["20", "25", "15", "30"], คำตอบที่ถูก: "20", อธิบาย: "(10+20+30)/3 = 60/3 = 20" },
    { ถาม: "จำนวนใดคือพหุนาม: 3x² + 2x − 5?", ตัวเลือก: ["ใช่", "ไม่ใช่", "แค่บางส่วน", "ไม่มีข้อมูล"], คำตอบที่ถูก: "ใช่", อธิบาย: "นิยามของพหุนามคือผลบวกของพจน์จำนวนจำกัด" }
  ];

  let ข้อที่ทำ = 0;
  let คะแนน = 0;
  let คงเหลือ = [...โจทย์];

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function ตรวจสอบชื่อ() {
    const ชื่อ = document.getElementById("ชื่อผู้ใช้").value.trim();
    const ปุ่มตกลง = document.getElementById("ตกลง");
    if (ชื่อ !== "") {
      ปุ่มตกลง.disabled = false;
      ปุ่มตกลง.style.display = "block"; // แสดงปุ่มตกลง
    } else {
      ปุ่มตกลง.disabled = true;
      ปุ่มตกลง.style.display = "none"; // ซ่อนปุ่มตกลงเมื่อไม่มีชื่อ
    }
  }

  function เริ่มโจทย์() {
    const ชื่อ = document.getElementById("ชื่อผู้ใช้").value.trim();
    if (!ชื่อ) return alert("กรุณากรอกชื่อก่อนเริ่มแบบทดสอบ");

    document.getElementById("ตกลง").style.display = "none"; // ซ่อนปุ่มตกลงหลังจากเริ่มข้อสอบ

    if (ข้อที่ทำ >= 10 || คงเหลือ.length === 0) return แสดงสรุป();

    const สุ่ม = Math.floor(Math.random() * คงเหลือ.length);
    const ข้อนี้ = คงเหลือ.splice(สุ่ม, 1)[0];

    document.getElementById("โจทย์").innerText = `ข้อที่ ${ข้อที่ทำ + 1}: ${ข้อนี้.ถาม}`;
    document.getElementById("ผลลัพธ์").innerText = "";
    document.getElementById("อธิบาย").innerText = "";
    const พื้นที่ = document.getElementById("ตัวเลือกทั้งหมด");
    พื้นที่.innerHTML = "";

    shuffle([...ข้อนี้.ตัวเลือก]).forEach((ตัวเลือก) => {
      const ปุ่ม = document.createElement("button");
      ปุ่ม.innerText = ตัวเลือก;
      ปุ่ม.className = "ตัวเลือก";
      ปุ่ม.onclick = () => {
        ตรวจคำตอบ(ตัวเลือก, ข้อนี้.คำตอบที่ถูก, ข้อนี้.อธิบาย);
        [...document.getElementsByClassName("ตัวเลือก")].forEach(b => b.disabled = true);
        document.getElementById("ถัดไป").style.display = "inline-block";
      };
      พื้นที่.appendChild(ปุ่ม);
    });
  }

  function ตรวจคำตอบ(เลือก, คำตอบ, อธิบาย) {
    ข้อที่ทำ++;
    if (เลือก === คำตอบ) {
      คะแนน++;
      document.getElementById("ผลลัพธ์").innerText = "✅ ถูกต้อง!";
      document.getElementById("ผลลัพธ์").style.color = "green";
    } else {
      document.getElementById("ผลลัพธ์").innerText = `❌ ผิด! คำตอบที่ถูกคือ: ${คำตอบ}`;
      document.getElementById("ผลลัพธ์").style.color = "red";
    }
    document.getElementById("อธิบาย").innerText = "📘 อธิบาย: " + อธิบาย;
    document.getElementById("คะแนน").innerText = `คะแนน: ${คะแนน} จาก ${ข้อที่ทำ} ข้อ`;
  }

  function ไปข้อถัดไป() {
    document.getElementById("ถัดไป").style.display = "none"; // ซ่อนปุ่มถัดไป
    if (ข้อที่ทำ >= 10) {
      แสดงสรุป();
    } else {
      เริ่มโจทย์();
    }
  }

  function แสดงสรุป() {
    const ชื่อ = document.getElementById("ชื่อผู้ใช้").value.trim();
    document.getElementById("โจทย์").innerText = "🎉 แบบทดสอบเสร็จสิ้น";
    document.getElementById("ตัวเลือกทั้งหมด").innerHTML = "";
    document.getElementById("ผลลัพธ์").innerText = "";
    document.getElementById("อธิบาย").innerText = "";
    document.getElementById("สรุป").innerHTML = `
      🙍‍♂️ ผู้ทำแบบทดสอบ: ${ชื่อ}<br>
      ✅ ถูกต้อง: ${คะแนน} ข้อ<br>
      ❌ ผิด: ${10 - คะแนน} ข้อ<br><br>
      🏆 คะแนนรวม: ${คะแนน} / 10
    `;
    document.getElementById("ปุ่มเริ่มใหม่").innerHTML = `
      <button id="เริ่มใหม่" onclick="location.reload()">เริ่มใหม่</button>
    `;
  }
</script>
</body>
</html>
